        data: dict | None = None,
    ):
        return await NotificationService.send_to_staff_email(
            email=email,
            title=title,
            body=body,
            data=data,
        )

    # =========================================================
    # SEND DIRECTLY TO TOKEN
    # =========================================================

    @staticmethod
    async def send_to_token(
        token: str,
        title: str | None = None,
